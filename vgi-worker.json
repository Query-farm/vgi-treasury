    {
      "name": "reversed dates",
      "sql": "SELECT * FROM treasury.main.debt_to_penny(start_date := '2024-02-01', end_date := '2024-01-01')",
      "message": "must not be after"
    },
    {
      "name": "invalid date",
      "sql": "SELECT * FROM treasury.main.debt_to_penny(start_date := '2024-02-30')",
